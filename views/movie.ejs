<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= (movie && movie.title) ? movie.title : 'Movie Details' %></title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #141414; color: #ffffff; padding: 20px; }
        .container { max-width: 900px; margin: 0 auto; }
        .back-link { display: inline-block; margin-bottom: 15px; color: #aaa; text-decoration: none; font-size: 14px; }
        .back-link:hover { color: #fff; }
        .movie-title { margin-bottom: 15px; font-size: 24px; }
        .video-player-box { background-color: #000; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.6); position: relative; min-height: 450px; }
        video, iframe { width: 100%; height: 450px; display: block; border: none; }
        .player-controls { display: flex; justify-content: center; align-items: center; gap: 15px; background-color: #1f1f1f; padding: 12px; }
        .control-btn { background-color: #e50914; color: #fff; border: none; padding: 8px 16px; font-size: 14px; font-weight: bold; border-radius: 4px; cursor: pointer; }
        .control-btn:hover { background-color: #b80710; }
        .movie-details { margin-top: 20px; background-color: #1f1f1f; padding: 20px; border-radius: 8px; }
        .movie-details p { margin-bottom: 10px; font-size: 15px; }
        .server-buttons { margin-top: 15px; }
        .server-btn { display: inline-block; background-color: #333; color: #fff; padding: 8px 14px; margin-right: 8px; margin-bottom: 8px; border-radius: 4px; border: none; cursor: pointer; font-size: 14px; }
        .server-btn:hover { background-color: #555; }
        .server-btn.active { background-color: #e50914; }
        .error-box { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 450px; color: #ff4a4a; font-size: 18px; text-align: center; padding: 20px; }
        .terabox-container { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 450px; padding: 20px; text-align: center; background: #111827; }
        .terabox-btn { background-color: #e50914; color: #ffffff; padding: 14px 28px; border-radius: 6px; text-decoration: none; font-weight: bold; font-size: 16px; margin-top: 15px; }
    </style>
</head>
<body>

    <div class="container">
        <a href="/" class="back-link">← Back to Home</a>
        
        <h2 class="movie-title"><%= (movie && movie.title) ? movie.title : 'Movie' %></h2>

        <div class="video-player-box">
            <div id="mediaArea">
                <div class="error-box">Loading Media Player...</div>
            </div>

            <div class="player-controls" id="controlsBox" style="display: none;">
                <button class="control-btn" onclick="rewind(5)">⏪ 5 Sec</button>
                <button class="control-btn" onclick="forward(5)">5 Sec ⏩</button>
            </div>
        </div>

        <div class="movie-details">
            <p><strong>Category:</strong> <%= (movie && movie.category) ? movie.category : 'N/A' %></p>
            <p><strong>Views:</strong> <%= (movie && movie.views) ? movie.views : 0 %></p>

            <div class="server-buttons" id="seasonsContainer" style="display: none;">
                <strong>Seasons:</strong><br><br>
                <div id="seasonButtonsBox"></div>
            </div>

            <div class="server-buttons" id="episodesContainer" style="display: none; margin-top: 15px;">
                <strong>Episodes:</strong><br><br>
                <div id="episodesButtonsBox"></div>
            </div>

            <div class="server-buttons" id="serversContainer" style="display: none;">
                <strong>Select Server:</strong><br><br>
                <div id="serverButtonsBox"></div>
            </div>
        </div>
    </div>

    <script>
        // Server data debug log
        const movieData = <%- JSON.stringify(movie || {}) %>;
        console.log("Loaded Movie Data:", movieData);

        function extractUrl(item) {
            if (!item) return '';
            if (typeof item === 'string') return item;
            return item.url || item.videoUrl || item.embedUrl || item.link || (item.videoLinks && item.videoLinks[0] ? item.videoLinks[0].url : '');
        }

        function processDriveUrl(url) {
            if (!url || typeof url !== 'string') return url;
            if (url.includes('drive.google.com')) {
                return url.replace(/\/view(\?.*)?$/, '/preview')
                          .replace(/\/edit(\?.*)?$/, '/preview')
                          .replace(/\/usp=sharing$/, '');
            }
            return url;
        }

        function parseYouTubeUrl(url) {
            if (!url || typeof url !== 'string') return null;
            let regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
            let match = url.match(regExp);
            return (match && match[2].length === 11) ? match[2] : null;
        }

        function switchVideoServer(rawUrl, elementBtn) {
            const mediaArea = document.getElementById('mediaArea');
            const controlsBox = document.getElementById('controlsBox');

            if (!rawUrl) {
                mediaArea.innerHTML = `<div class="error-box">❌ No Video Stream URL Found!</div>`;
                if (controlsBox) controlsBox.style.display = 'none';
                return;
            }

            const url = processDriveUrl(rawUrl);

            if (elementBtn) {
                const siblingBtns = elementBtn.parentElement.querySelectorAll('.server-btn');
                siblingBtns.forEach(btn => btn.classList.remove('active'));
                elementBtn.classList.add('active');
            }

            const isTeraBox = /terabox|neobox|teraboxapp|1024tera|freeterabox/i.test(url);
            const ytId = parseYouTubeUrl(url);
            const isEmbedLink = url.includes('/e/') || url.includes('/embed/') || url.includes('tpead.net') || url.includes('drive.google.com');

            if (isTeraBox) {
                mediaArea.innerHTML = `
                    <div class="terabox-container">
                        <p style="font-size: 20px; font-weight: 600; color: #fff;">TeraBox Server Selected</p>
                        <a href="${url}" target="_blank" rel="noopener noreferrer" class="terabox-btn">
                            ▶ Watch / Download on TeraBox
                        </a>
                    </div>
                `;
                if (controlsBox) controlsBox.style.display = 'none';
            } else if (ytId) {
                mediaArea.innerHTML = `<iframe id="ytPlayer" src="https://www.youtube.com/embed/${ytId}?autoplay=1" allowfullscreen allow="autoplay"></iframe>`;
                if (controlsBox) controlsBox.style.display = 'none';
            } else if (isEmbedLink) {
                mediaArea.innerHTML = `<iframe id="embedPlayer" src="${url}" allowfullscreen allow="autoplay" scrolling="no"></iframe>`;
                if (controlsBox) controlsBox.style.display = 'none';
            } else {
                const posterUrl = movieData.poster || '';
                mediaArea.innerHTML = `
                    <video id="mainVideo" controls autoplay poster="${posterUrl}">
                        <source src="${url}" type="video/mp4">
                        Your browser does not support playing this video.
                    </video>
                `;
                if (controlsBox) controlsBox.style.display = 'flex';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            let initialUrl = '';

            // Check structure of dataset
            if (movieData.episodes && movieData.episodes.length > 0) {
                document.getElementById('episodesContainer').style.display = 'block';
                const seasonsMap = {};
                
                movieData.episodes.forEach((ep, index) => {
                    let sNum = (typeof ep === 'object' && ep !== null) ? (ep.season || ep.seasonNumber || ep.s || 1) : 1;
                    if (!seasonsMap[sNum]) seasonsMap[sNum] = [];
                    seasonsMap[sNum].push({ data: ep, index: index + 1 });
                });

                const seasonKeys = Object.keys(seasonsMap).sort((a, b) => Number(a) - Number(b));
                const episodesButtonsBox = document.getElementById('episodesButtonsBox');

                function renderEpisodes(seasonKey) {
                    episodesButtonsBox.innerHTML = '';
                    const seasonEps = seasonsMap[seasonKey] || [];

                    seasonEps.forEach((item, idx) => {
                        let epUrl = extractUrl(item.data);
                        let epNum = (typeof item.data === 'object') ? (item.data.episode || item.data.episodeNumber || item.index) : item.index;
                        let epTitle = (typeof item.data === 'object' && item.data.title) ? item.data.title : ('Episode ' + epNum);

                        if (idx === 0 && !initialUrl) initialUrl = epUrl;

                        const btn = document.createElement('button');
                        btn.className = 'server-btn ep-btn' + (idx === 0 ? ' active' : '');
                        btn.innerText = epTitle;
                        btn.onclick = function() { switchVideoServer(epUrl, this); };
                        episodesButtonsBox.appendChild(btn);
                    });
                }

                if (seasonKeys.length > 1) {
                    const seasonsContainer = document.getElementById('seasonsContainer');
                    const seasonButtonsBox = document.getElementById('seasonButtonsBox');
                    seasonsContainer.style.display = 'block';
                    seasonButtonsBox.innerHTML = '';

                    seasonKeys.forEach((sKey, idx) => {
                        const btn = document.createElement('button');
                        btn.className = 'server-btn season-btn' + (idx === 0 ? ' active' : '');
                        btn.innerText = 'Season ' + sKey;
                        btn.onclick = function() {
                            document.querySelectorAll('.season-btn').forEach(b => b.classList.remove('active'));
                            this.classList.add('active');
                            renderEpisodes(sKey);
                        };
                        seasonButtonsBox.appendChild(btn);
                    });
                }
                renderEpisodes(seasonKeys[0]);
            } 
            else if (movieData.videoLinks && movieData.videoLinks.length > 0) {
                const serversContainer = document.getElementById('serversContainer');
                const serverButtonsBox = document.getElementById('serverButtonsBox');
                serversContainer.style.display = 'block';
                serverButtonsBox.innerHTML = '';

                movieData.videoLinks.forEach((link, idx) => {
                    let sUrl = extractUrl(link);
                    let sName = (typeof link === 'object' && link.name) ? link.name : ('Server ' + (idx + 1));
                    
                    if (idx === 0) initialUrl = sUrl;

                    const btn = document.createElement('button');
                    btn.className = 'server-btn link-btn' + (idx === 0 ? ' active' : '');
                    btn.innerText = sName;
                    btn.onclick = function() { switchVideoServer(sUrl, this); };
                    serverButtonsBox.appendChild(btn);
                });
            } 
            else if (movieData.videoUrl || movieData.url || movieData.link) {
                initialUrl = movieData.videoUrl || movieData.url || movieData.link;
            }

            // Auto-play initial URL
            switchVideoServer(initialUrl, null);
        });

        function rewind(seconds = 5) {
            const video = document.getElementById('mainVideo');
            if (video) video.currentTime = Math.max(0, video.currentTime - seconds);
        }

        function forward(seconds = 5) {
            const video = document.getElementById('mainVideo');
            if (video) {
                const maxTime = isNaN(video.duration) ? video.currentTime + seconds : video.duration;
                video.currentTime = Math.min(maxTime, video.currentTime + seconds);
            }
        }
    </script>
</body>
</html>
